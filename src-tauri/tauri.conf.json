{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "spotcast",
  "version": "1.1.0",
  "identifier": "com.allister.spotcast",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "spotcast",
        "width": 680,
        "height": 450,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "alwaysOnTop": true,
        "visible": false,
        "center": true,
        "skipTaskbar": true,
        "resizable": false
      }
    ],
    "trayIcon": {
      "iconPath": "icons/TrayIcon.png",
      "id": "spotcast-tray",
      "tooltip": "Spotcast",
      "showMenuOnLeftClick": false
    },
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon.ico",
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png"
    ]
  }
}
